# 注意：.env 中的 JSON 必须写成一行，python-dotenv 不支持裸值跨行。
# 需要换行排版时，请用单引号把整段 JSON 包起来：KEY='[\n  {...}\n]'

# AnyRouter 账号配置（可选，支持多账号）
ANYROUTER_ACCOUNTS=[{"cookies":{"session":"你的session值"},"api_user":"你的api_user值"}]

# AgentRouter 账号配置（可选，邮箱 + 密码，支持多账号）
AGENTROUTER_ACCOUNTS=[{"email":"user@example.com","password":"your_password"}]

# 两个平台都无需 name 字段；想在通知里显示自定义名称时才加，例如：
# ANYROUTER_ACCOUNTS=[{"name":"主力号","cookies":{"session":"xxx"},"api_user":"12345"}]

# 通知开关：失败始终通知；下面两项各自独立控制
# NOTIFY_ON_SUCCESS=true 时推送签到成功
NOTIFY_ON_SUCCESS=false
# NOTIFY_ON_SKIPPED=true 时推送今日已签
NOTIFY_ON_SKIPPED=false

# 可选：通知配置
# DINGDING_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# EMAIL_USER=your_email@example.com
# EMAIL_PASS=your_password
# EMAIL_TO=recipient@example.com
# XIZHI_KEY=your_xizhi_key
# SERVERPUSHKEY=your_server_pushkey
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# WEIXIN_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
